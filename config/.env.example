# ===========================================
# neu-scholar-backend — Environment Variables
# ===========================================
# Copy to .env for local dev, or set in Portainer Stack → Environment variables

# --- BẮT BUỘC ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fitneu

# --- TÙY CHỌN ---
PORT=8014
SESSION_SECRET=your-secret-change-in-production

# --- Ollama (LLM + Embedding, chạy local) ---
# OLLAMA_BASE_URL=http://localhost:11434          # local dev
# OLLAMA_BASE_URL=http://host.docker.internal:11434 # Docker, ollama trên host port 8002
# OLLAMA_BASE_URL=http://ollama:11434              # Docker, cùng network với container ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
# USE_OLLAMA_EMBEDDING=true

# --- Fallback embedding (nếu không dùng Ollama) ---
# USE_REMOTE_EMBEDDING=false
# OPENAI_API_KEY=   # chỉ khi USE_REMOTE_EMBEDDING=true

# --- File storage (MinIO / S3) ---
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=neu-scholar
# MINIO_REGION=us-east-1
