# ===========================================
# Local dev — copy thành docker-compose.override.yml để dùng .env + hot reload
# ===========================================
# cp docker-compose.override.yml.example docker-compose.override.yml

services:
  backend:
    build:
      target: development
    env_file:
      - .env
    volumes:
      - .:/app
      - /app/node_modules
