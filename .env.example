# ===========================================
# neu-scholar-backend — Environment Variables
# ===========================================
# Copy to .env for local dev, or set in Portainer Stack → Environment variables

# --- BẮT BUỘC ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fitneu

# --- TÙY CHỌN ---
PORT=8014
SESSION_SECRET=your-secret-change-in-production

# --- LLM (chọn 1 trong các key) ---
# QWEN_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Vector search / Embedding ---
# USE_REMOTE_EMBEDDING=false
# EMBEDDING_MODEL=Xenova/paraphrase-multilingual-mpnet-base-v2

# --- File storage (MinIO / S3) ---
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET_NAME=neu-scholar
# MINIO_REGION=us-east-1
